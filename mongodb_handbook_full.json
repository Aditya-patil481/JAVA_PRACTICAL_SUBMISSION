  },
  "operations": {
    "database": [
      "show dbs",
      "use ecommerce",
      "show collections",
      "db.dropDatabase()"
    ],
    "products_queries": [
      "db.products.find()",
      "db.products.find().pretty()",
      "db.products.find({ category: \"Electronics\" })",
      "db.products.find({ price: { $gt: 1000 } })",
      "db.products.find({ price: { $gte: 1000, $lte: 50000 } })",
      "db.products.find({ $or: [{ category: \"Electronics\" }, { stock: { $lt: 50 } }] })",
      "db.products.find({}, { name: 1, price: 1, _id: 0 })",
      "db.products.find().sort({ price: -1 }).limit(2)",
      "db.products.updateOne({ name: \"Wireless Mouse\" }, { $set: { price: 899 } })",
      "db.products.updateMany({ category: \"Electronics\" }, { $inc: { stock: 10 } })",
      "db.products.updateOne({ name: \"Wireless Mouse\" }, { $push: { tags: \"new\" } })",
      "db.products.createIndex({ name: 1 })",
      "db.products.getIndexes()",
      "db.products.find({ price: { $gt: 5000 } }).explain(\"executionStats\")",
      "db.products.renameCollection(\"items\")",
      "db.products.drop()"
    ],
    "orders_queries": [
      "db.orders.find()",
      "db.orders.deleteMany({ status: \"Delivered\" })",
      "db.orders.aggregate([{ $group: { _id: null, totalRevenue: { $sum: \"$total\" } } }])",
      "db.orders.aggregate([{ $group: { _id: \"$status\", count: { $sum: 1 } } }])",
      "db.orders.aggregate([{ $lookup: { from: \"products\", localField: \"products.name\", foreignField: \"name\", as: \"productDetails\" } }])"
    ],
    "contacts_queries": [
      "db.contacts.find()",
      "db.contacts.deleteOne({ name: \"Alice\" })"
    ],
    "sales_queries": [
      "db.sales.find()",
      "db.sales.aggregate([{ $match: { category: \"Fruit\" } }])",
      "db.sales.aggregate([{ $project: { item: 1, price: 1, _id: 0 } }])",
      "db.sales.aggregate([{ $group: { _id: \"$category\", totalSales: { $sum: { $multiply: [\"$price\", \"$quantity\"] } } } }])",
      "db.sales.aggregate([{ $group: { _id: \"$category\", totalSales: { $sum: { $multiply: [\"$price\", \"$quantity\"] } } } }, { $sort: { totalSales: -1 } }])",
      "db.sales.aggregate([{ $match: { category: \"Fruit\" } }, { $group: { _id: null, totalFruitSales: { $sum: { $multiply: [\"$price\", \"$quantity\"] } } } }])"
    ],
    "admin_queries": [
      "db.stats()",
      "db.serverStatus()",
      "db.products.countDocuments()",
      "db.products.createIndex({ name: 1 })",
      "db.products.getIndexes()"
    ]
  },
  "aggregation_results": {
    "Fruit": 145,
    "Vegetable": 96,
    "totalFruitSales": 145
  }
}